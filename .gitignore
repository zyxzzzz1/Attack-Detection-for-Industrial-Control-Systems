# Virtualenv and caches
.venv/
__pycache__/
.pytest_cache/

# HAI raw data is not tracked
data/raw/

# Threat-intel cache (KEV/EPSS) is not tracked
data/intel/

# Derived output generated from mock alerts is not tracked (data/mock/ itself is tracked)
data/processed/enriched_alerts*.json
reports/extension/e3_compare.md
reports/cards/
reports/cards_mock/

# Machine-private cluster config (user name, absolute paths on the cluster) and the real job scripts generated from it
config/cluster.local.yaml
cluster/local/

# Commit hash written temporarily by push_to_cluster.sh (there is no .git on the cluster)
.git_commit

# Main-line intermediate artifacts (models, scores, checkpoints) are not tracked
artifacts/
CLAUDE.md
CLAUDE.md
.claude/
