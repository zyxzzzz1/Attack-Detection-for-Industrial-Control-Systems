#!/bin/bash
#SBATCH --job-name={{ name }}
#SBATCH --partition={{ job.partition }}
{%- if job.gres is defined %}
#SBATCH --gres={{ job.gres }}
{%- endif %}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{ job.cpus_per_task }}
#SBATCH --mem={{ job.mem }}
{%- if not job.time.startswith('TODO') %}
#SBATCH --time={{ job.time }}
{%- else %}
# --time is not yet set in cluster.yaml: it must be given explicitly at submission, e.g. sbatch --time=02:00:00 ...
{%- endif %}
{%- if array %}
#SBATCH --array={{ array }}
#SBATCH --output={{ paths.artifact_dir }}/slurm_logs/%x_%A_%a.out
{%- else %}
#SBATCH --output={{ paths.artifact_dir }}/slurm_logs/%x_%j.out
{%- endif %}
#
# Generated by scripts/make_cluster_jobs.py from config/cluster.yaml; do not edit by hand (edit cluster/templates/ or cluster.yaml and regenerate).
{%- if todo_keys %}
# Note: cluster.yaml still has TODOs that affect jobs ({{ todo_keys | join(", ") }}); do not submit on the cluster until they are filled in and the scripts regenerated.
{%- endif %}
#
# Train, score, threshold and evaluate one model. If the job is interrupted, resubmit it unchanged to resume from the checkpoint (--resume).
# Usage:
#   sbatch [--time=HH:MM:SS] cluster/train_one.sbatch <model> [other run_model arguments, e.g. --set ml.train.max_epochs=1]
#   bash cluster/train_one.sbatch --smoke <model> [...]        # local smoke run, no scheduler
set -euo pipefail

if [[ "${1:-}" == "--smoke" ]]; then SMOKE=1; shift; else SMOKE=0; fi
if [[ "${SMOKE}" == "1" ]]; then
    # shellcheck source=/dev/null
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/job_common.sh"
else
    # sbatch copies the script to a spool directory, so use the absolute path of the code directory
    # shellcheck source=/dev/null
    source "{{ paths.code_dir }}/cluster/job_common.sh"
fi

MODEL="${1:?用法：train_one.sbatch [--smoke] <模型名> [--set key=value ...]}"
shift
python -m src.run_model --model "${MODEL}" --resume "${SMOKE_ARGS[@]}" "$@"
