#!/bin/bash
#SBATCH --job-name={{ name }}
#SBATCH --partition={{ job.partition }}
{%- if job.gres is defined %}
#SBATCH --gres={{ job.gres }}
{%- endif %}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{ job.cpus_per_task }}
#SBATCH --mem={{ job.mem }}
{%- if not job.time.startswith('TODO') %}
#SBATCH --time={{ job.time }}
{%- else %}
# --time is not yet set in cluster.yaml: it must be given explicitly at submission, e.g. sbatch --time=02:00:00 ...
{%- endif %}
{%- if array %}
#SBATCH --array={{ array }}
#SBATCH --output={{ paths.artifact_dir }}/slurm_logs/%x_%A_%a.out
{%- else %}
#SBATCH --output={{ paths.artifact_dir }}/slurm_logs/%x_%j.out
{%- endif %}
#
# Generated by scripts/make_cluster_jobs.py from config/cluster.yaml; do not edit by hand (edit cluster/templates/ or cluster.yaml and regenerate).
{%- if todo_keys %}
# Note: cluster.yaml still has TODOs that affect jobs ({{ todo_keys | join(", ") }}); do not submit on the cluster until they are filled in and the scripts regenerated.
{%- endif %}
#
# LSTM-AE ablation (M4): job array; for the mapping task index -> (W, hidden) see python -m src.run_model --list-ablation.
# Each task's artifacts are in <artifact dir>/ablation/lstm_ae_w<W>_h<hidden>/. The sensitivity analysis over threshold quantiles {99, 99.5, 99.9}
# only re-takes quantiles of the val_thr scores saved by each task; no extra array tasks are needed.
# Usage:
#   sbatch [--time=HH:MM:SS] cluster/ablation_array.sbatch [other run_model arguments]
#   sbatch --array=4 cluster/ablation_array.sbatch              # rerun a single task (an interrupted task resumes from its checkpoint)
#   bash cluster/ablation_array.sbatch --smoke [task index, default 0]  # local smoke run, no scheduler
set -euo pipefail

if [[ "${1:-}" == "--smoke" ]]; then SMOKE=1; shift; else SMOKE=0; fi
if [[ "${SMOKE}" == "1" ]]; then
    # shellcheck source=/dev/null
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/job_common.sh"
else
    # sbatch copies the script to a spool directory, so use the absolute path of the code directory
    # shellcheck source=/dev/null
    source "{{ paths.code_dir }}/cluster/job_common.sh"
fi

if [[ "${SMOKE}" == "1" ]]; then
    INDEX="${1:-0}"
    [[ $# -gt 0 ]] && shift
else
    INDEX="${SLURM_ARRAY_TASK_ID:?must be submitted as a job array}"
fi
python -m src.run_model --ablation-index "${INDEX}" --resume "${SMOKE_ARGS[@]}" "$@"
