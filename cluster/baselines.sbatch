#!/bin/bash
#SBATCH --job-name=hai-baselines
#SBATCH --partition=long
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=00:05:00
#SBATCH --output=TODO 写在 config/cluster.local.yaml/slurm_logs/%x_%j.out
#
# Generated by scripts/make_cluster_jobs.py from config/cluster.yaml; do not edit by hand (edit cluster/templates/ or cluster.yaml and regenerate).
# Note: cluster.yaml still has TODOs that affect jobs (paths.code_dir, paths.venv_dir, paths.data_dir, paths.artifact_dir); do not submit on the cluster until they are filled in and the scripts regenerated.
#
# PCA and IsolationForest: training, scoring, threshold, evaluation. CPU only.
# Usage:
#   sbatch [--time=HH:MM:SS] cluster/baselines.sbatch [other run_model arguments]
#   bash cluster/baselines.sbatch --smoke [...]                 # local smoke run, no scheduler
set -euo pipefail

if [[ "${1:-}" == "--smoke" ]]; then SMOKE=1; shift; else SMOKE=0; fi
if [[ "${SMOKE}" == "1" ]]; then
    # shellcheck source=/dev/null
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/job_common.sh"
else
    # sbatch copies the script to a spool directory, so use the absolute path of the code directory
    # shellcheck source=/dev/null
    source "TODO 写在 config/cluster.local.yaml/cluster/job_common.sh"
fi

for MODEL in pca iforest; do
    python -m src.run_model --model "${MODEL}" --resume "${SMOKE_ARGS[@]}" "$@"
done
