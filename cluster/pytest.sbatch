#!/bin/bash
#SBATCH --job-name=hai-pytest
#SBATCH --gres=gpu:L4:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:20:00
#SBATCH --output=TODO set in config/cluster.local.yaml/slurm_logs/%x_%j.out
#
# Generated by scripts/make_cluster_jobs.py from config/cluster.yaml; do not edit by hand.
# Environment check: run the full pytest on a GPU node and confirm torch can use the GPU. Default partition (no -p).
# The first job on the cluster is the srun pytest (see step 5 of docs/cluster_runbook.md); this script is its GPU complement.
# Usage:
#   sbatch cluster/pytest.sbatch
#   bash cluster/pytest.sbatch --smoke                          # local, no scheduler
set -euo pipefail

if [[ "${1:-}" == "--smoke" ]]; then SMOKE=1; shift; else SMOKE=0; fi
if [[ "${SMOKE}" == "1" ]]; then
    # shellcheck source=/dev/null
    source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/job_common.sh"
else
    # sbatch copies the script to a spool directory, so use the absolute path of the code directory
    # shellcheck source=/dev/null
    source "TODO set in config/cluster.local.yaml/cluster/job_common.sh"
fi

python -m pytest -q
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
if [[ "${SMOKE}" != "1" ]]; then
    python -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 'A GPU was requested but torch cannot use it: check the CUDA build of torch and the driver version (env/README.md)')"
fi
