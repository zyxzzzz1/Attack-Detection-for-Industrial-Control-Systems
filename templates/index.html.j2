{% extends "_base.html.j2" %}
{% block title %}Alert list{% endblock %}
{% block content %}
<h1>Alert list <span class="muted">sorted by priority</span></h1>
{% if meta.is_mock %}
<div class="banner mock">[MOCK] Alerts come from mock data; scores and times are made-up values, not model output.</div>
{% endif %}
<div class="banner disclaimer">Disclaimer: {{ disclaimer }}</div>
<p class="muted">{{ "Generated at {time}; α={alpha}, β={beta}, γ={gamma}, min_qod={qod}".format(time=meta.generated_at, alpha=meta.params.alpha, beta=meta.params.beta, gamma=meta.params.gamma, qod=meta.params.min_qod) }}</p>
{% if alerts | length < n_total %}
<p>{{ "{n} alerts in total; this page lists only the {m} with the highest priority (cards were generated only for these).".format(n=n_total, m=alerts | length) }}</p>
{% endif %}
{% if not meta.is_mock %}
<p class="muted">Alerts are the raw output of the detection model, have not been confirmed by a human, and include false alarms.</p>
{% endif %}
<table>
  <tr><th>Rank</th><th>Alert</th><th>Start time</th><th>Priority</th><th>Score / threshold</th><th>S</th><th>Subsystem</th><th>E_sub</th><th>KEV vulns needing review</th></tr>
  {% for a in alerts %}
  <tr><td class="num">{{ a.rank }}</td>
      <td><a href="{{ card_name(a, 'html') }}">{{ a.alert_id }}</a>{% if a.is_mock is defined and a.is_mock %} <span class="mock">[MOCK]</span>{% endif %}</td>
      <td>{{ a.start }}</td><td class="num"><b>{{ a.priority | f3 }}</b></td><td class="num">{{ "%.2f" | format(a.max_score / a.threshold) }}</td><td class="num">{{ a.S | f3 }}</td>
      <td>{% for s in shown_subsystems(a, 1) %}{{ s.id }} {{ s.weight | pct }}{{ ", " if not loop.last }}{% else %}-{% endfor %}</td>
      <td class="num">{{ a.E_sub | f3 }}{% if exposure(a) == "not_assessed" %} <span class="review">Not assessed: no upstream asset scanned</span>{% elif exposure(a) == "partial" %} <span class="review">Possibly underestimated</span>{% endif %}</td><td class="num">{{ a.needs_review | length }}</td></tr>
  {% endfor %}
</table>
<p class="muted">Order: by Priority (unrounded value), descending. Alerts with equal Priority are ordered by S, descending, and then by alert ID, ascending.</p>
<p class="muted">"Possibly underestimated": some of the assets on the path have not been assessed (not scanned); they are counted as 0. "Not assessed": no upstream asset has been scanned; E_sub is recorded as 0.</p>
{% endblock %}
