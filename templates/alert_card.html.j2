{% extends "_base.html.j2" %}
{% block title %}{{ "Alert {id}".format(id=a.alert_id) }}{% endblock %}
{% block content %}
{% macro esub(s) -%}
{% if not s.has_assets %}E_sub = {{ s.E_sub | f3 }} (no control chain: HIL simulation){% elif not s.E_sub_assessed %}E_sub not assessed (no upstream asset has been scanned; counted as 0){% else %}E_sub = {{ s.E_sub | f3 }}{% if s.unassessed_assets %}{{ " ({n} more upstream assets not assessed)".format(n=s.unassessed_assets | length) }}{% endif %}{% endif %}
{%- endmacro %}
<p><a href="index.html">← Alert list</a></p>
<h1>{{ "Alert {id}".format(id=a.alert_id) }} <span class="muted">{{ "Priority rank {rank} / {n}".format(rank=a.rank, n=n_alerts) }}</span></h1>
{% if a.is_mock is defined and a.is_mock %}
<div class="banner mock">[MOCK] {{ "This alert was generated from a mock alert ({case}); scores and times are made-up values, not model output.".format(case=(a.mock_case) if a.mock_case is defined else "mock") }}</div>
{% endif %}
<div class="banner disclaimer">Disclaimer: {{ disclaimer }}</div>

<h2>Summary</h2>
<div class="kpis">
  <div class="kpi">Priority<b>{{ a.priority | f3 }}</b></div>
  <div class="kpi">Anomaly severity S<b>{{ a.S | f3 }}</b></div>
  <div class="kpi">Weighted E_sub<b>{{ a.E_sub | f3 }}</b>{% if exposure(a) == "not_assessed" %}<span class="review">Not assessed: no upstream asset scanned</span>{% elif exposure(a) == "partial" %}<span class="review">Possibly underestimated</span>{% endif %}</div>
  <div class="kpi">Score / threshold<b>{{ "{ratio}x".format(ratio="%.2f" | format(ratio)) }}</b></div>
</div>
<table>
  <tr><th>Start ~ end</th><td>{{ a.start }} ~ {{ a.end }}</td></tr>
  <tr><th>Duration</th><td>{{ duration }}</td></tr>
  <tr><th>Max anomaly score / threshold</th><td>{{ "%.4f" | format(a.max_score) }} / {{ "%.4f" | format(a.threshold) }}</td></tr>
</table>

<h2>{{ "Top-{k} anomalous sensors".format(k=a.topk | length) }}</h2>
<table>
  <tr><th>Sensor</th><th>Share of total sensor error</th><th>Subsystem</th></tr>
  {% for t in a.topk %}
  <tr><td><code>{{ t.sensor }}</code></td><td class="num">{{ t.share | pct }}</td><td>{{ t.subsystem or "Unknown prefix (excluded from weighting)" }}</td></tr>
  {% endfor %}
</table>

<h2>Inferred affected subsystems</h2>
<ul>
{% for s in a.subsystems %}
  <li><b>{{ s.id }} {{ s.name }}</b>{{ ": weight {weight}, business criticality {crit}, exposure risk ".format(weight=s.weight | pct, crit=s.criticality) }}{{ esub(s) }}
  {% if s.note %}<div class="banner review">Note: {{ s.note }}</div>{% endif %}</li>
{% else %}
  <li>The affected subsystem cannot be identified (none of the Top-k sensor prefixes is in the asset map).</li>
{% endfor %}
{% if a.unmapped_sensors %}
  <li>Unmapped sensors: {% for x in a.unmapped_sensors %}<code>{{ x }}</code>{{ ", " if not loop.last }}{% endfor %}</li>
{% endif %}
</ul>

<h2>Possible intrusion paths</h2>
{% if a.risk_underestimated %}
<div class="banner review">Note: {{ UNDERESTIMATED }}{{ " (not assessed: {assets})".format(assets=a.unassessed_assets | join(", ")) }}</div>
{% endif %}
<ul>
{% for p in a.path %}
  <li>{{ p.subsystem }}: <span class="path">{{ p.path | join(" → ") }}</span></li>
{% else %}
  <li>None (the affected subsystems have no control chain attached).</li>
{% endfor %}
</ul>
{% if a.path_assets %}
<table>
  <tr><th>Asset</th><th>Risk R_asset</th><th>Status</th><th>Vulnerabilities counted</th><th>KEV vulns needing review</th></tr>
  {% for x in a.path_assets %}
  <tr><td>{{ x.asset }}</td><td class="num">{{ x.R_asset | risk }}</td><td>{{ status_text[x.status] }}</td><td class="num">{{ x.n_vulns }}</td><td class="num">{{ x.n_needs_review }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>{{ "High-risk vulnerabilities on the path assets (sorted by r_v, QoD ≥ {q})".format(q=meta.params.min_qod) }}</h2>
{% if a.vulns %}
<table>
  <tr><th>#</th><th>Asset</th><th>Port</th><th>Vulnerability</th><th>CVSS</th><th>EPSS</th><th>KEV</th><th>QoD</th><th>r_v</th></tr>
  {% for v in a.vulns %}
  <tr><td class="num">{{ loop.index }}</td><td>{{ v.asset }}</td><td>{{ v.port }}</td><td>{{ v.name }}</td>
      <td class="num">{{ v.cvss }}</td><td class="num">{{ "%.3f" | format(v.epss) }}</td>
      <td>{% if v.in_kev %}<span class="kev">KEV</span> {{ v.kev_cves | join(", ") }}{% else %}-{% endif %}</td>
      <td class="num">{{ v.qod }}</td><td class="num">{{ v.r_v | f3 }}</td></tr>
  {% endfor %}
</table>
{% else %}
<p class="muted">No vulnerabilities on the path assets reach the QoD threshold.</p>
{% endif %}

{% if a.needs_review %}
<h2>Needs manual verification</h2>
<div class="banner review">{{ "The following vulnerabilities are in CISA KEV but have QoD < {q} (version comparison only). They are not included in the risk calculation and need manual verification that they really exist.".format(q=meta.params.min_qod) }}</div>
<table>
  <tr><th>Asset</th><th>Port</th><th>Vulnerability</th><th>KEV CVE</th><th>EPSS</th><th>QoD</th></tr>
  {% for v in a.needs_review %}
  <tr><td>{{ v.asset }}</td><td>{{ v.port }}</td><td>{{ v.name }}</td><td class="kev">{{ v.kev_cves | join(", ") }}</td>
      <td class="num">{{ "%.3f" | format(v.epss) }}</td><td class="num">{{ v.qod }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>Recommended actions</h2>
<ol>
{% for step in actions.steps %}
  <li>{{ step }}</li>
{% endfor %}
</ol>
{% if actions.fixes %}
<p>OpenVAS remediation advice:</p>
<ul>
  {% for v in actions.fixes %}
  <li><b>{{ v.name }}</b>{{ " ({asset} {port}): ".format(asset=v.asset, port=v.port) }}{{ v.solution }}</li>
  {% endfor %}
</ul>
{% endif %}
{% endblock %}
