{% extends "_base.html.j2" %}
{% block title %}{{ _("告警 {id}").format(id=a.alert_id) }}{% endblock %}
{% block content %}
{% macro esub(s) -%}
{% if not s.has_assets %}E_sub = {{ s.E_sub | f3 }}{{ _("（无控制链：HIL 仿真）") }}{% elif not s.E_sub_assessed %}{{ _("E_sub 未评估（上游资产均未扫描，按 0 计算）") }}{% else %}E_sub = {{ s.E_sub | f3 }}{% if s.unassessed_assets %}{{ _("（另有 {n} 个上游资产未评估）").format(n=s.unassessed_assets | length) }}{% endif %}{% endif %}
{%- endmacro %}
<p><a href="index.html">← {{ _("告警列表") }}</a></p>
<h1>{{ _("告警 {id}").format(id=a.alert_id) }}{{ _("　") }}<span class="muted">{{ _("优先级第 {rank} / {n}").format(rank=a.rank, n=n_alerts) }}</span></h1>
{% if a.is_mock is defined and a.is_mock %}
<div class="banner mock">[MOCK] {{ _("本告警由 mock 报警生成（{case}），分数与时间为虚构值，不是模型输出。").format(case=(a.mock_case | trd) if a.mock_case is defined else "mock") }}</div>
{% endif %}
<div class="banner disclaimer">{{ _("免责声明：") }}{{ disclaimer }}</div>

<h2>{{ _("概要") }}</h2>
<div class="kpis">
  <div class="kpi">Priority<b>{{ a.priority | f3 }}</b></div>
  <div class="kpi">{{ _("异常严重度 S") }}<b>{{ a.S | f3 }}</b></div>
  <div class="kpi">{{ _("加权 E_sub") }}<b>{{ a.E_sub | f3 }}</b>{% if exposure(a) == "not_assessed" %}<span class="review">{{ _("未评估：上游资产均未扫描") }}</span>{% elif exposure(a) == "partial" %}<span class="review">{{ _("可能被低估") }}</span>{% endif %}</div>
  <div class="kpi">{{ _("分数 / 阈值") }}<b>{{ _("{ratio} 倍").format(ratio="%.2f" | format(ratio)) }}</b></div>
</div>
<table>
  <tr><th>{{ _("起止时间") }}</th><td>{{ a.start }} ~ {{ a.end }}</td></tr>
  <tr><th>{{ _("持续时长") }}</th><td>{{ duration }}</td></tr>
  <tr><th>{{ _("最大异常分数 / 阈值") }}</th><td>{{ "%.4f" | format(a.max_score) }} / {{ "%.4f" | format(a.threshold) }}</td></tr>
</table>

<h2>{{ _("Top-{k} 异常传感器").format(k=a.topk | length) }}</h2>
<table>
  <tr><th>{{ _("传感器") }}</th><th>{{ _("占全部传感器误差的比例") }}</th><th>{{ _("子系统") }}</th></tr>
  {% for t in a.topk %}
  <tr><td><code>{{ t.sensor }}</code></td><td class="num">{{ t.share | pct }}</td><td>{{ t.subsystem or _("未知前缀（不参与加权）") }}</td></tr>
  {% endfor %}
</table>

<h2>{{ _("推断受影响的子系统") }}</h2>
<ul>
{% for s in a.subsystems %}
  <li><b>{{ s.id }} {{ s.name | trd }}</b>{{ _("：权重 {weight}，业务关键度 {crit}，暴露风险 ").format(weight=s.weight | pct, crit=s.criticality) }}{{ esub(s) }}
  {% if s.note %}<div class="banner review">{{ _("说明：") }}{{ s.note | trd }}</div>{% endif %}</li>
{% else %}
  <li>{{ _("无法识别受影响的子系统（Top-k 传感器前缀均不在资产映射中）。") }}</li>
{% endfor %}
{% if a.unmapped_sensors %}
  <li>{{ _("未映射的传感器：") }}{% for x in a.unmapped_sensors %}<code>{{ x }}</code>{{ _("、") if not loop.last }}{% endfor %}</li>
{% endif %}
</ul>

<h2>{{ _("可能的入侵路径") }}</h2>
{% if a.risk_underestimated %}
<div class="banner review">{{ _("注意：") }}{{ _(UNDERESTIMATED) }}{{ _("（未评估：{assets}）").format(assets=a.unassessed_assets | join(_("、"))) }}</div>
{% endif %}
<ul>
{% for p in a.path %}
  <li>{{ p.subsystem }}{{ _("：") }}<span class="path">{{ p.path | join(" → ") }}</span></li>
{% else %}
  <li>{{ _("无（受影响子系统没有挂接控制链）。") }}</li>
{% endfor %}
</ul>
{% if a.path_assets %}
<table>
  <tr><th>{{ _("资产") }}</th><th>{{ _("风险 R_asset") }}</th><th>{{ _("状态") }}</th><th>{{ _("参与计算漏洞数") }}</th><th>{{ _("需核实的 KEV 漏洞") }}</th></tr>
  {% for x in a.path_assets %}
  <tr><td>{{ x.asset }}</td><td class="num">{{ x.R_asset | risk }}</td><td>{{ _(status_text[x.status]) }}</td><td class="num">{{ x.n_vulns }}</td><td class="num">{{ x.n_needs_review }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>{{ _("路径资产的高危漏洞（按 r_v 排序，QoD ≥ {q}）").format(q=meta.params.min_qod) }}</h2>
{% if a.vulns %}
<table>
  <tr><th>#</th><th>{{ _("资产") }}</th><th>{{ _("端口") }}</th><th>{{ _("漏洞") }}</th><th>CVSS</th><th>EPSS</th><th>KEV</th><th>QoD</th><th>r_v</th></tr>
  {% for v in a.vulns %}
  <tr><td class="num">{{ loop.index }}</td><td>{{ v.asset }}</td><td>{{ v.port }}</td><td>{{ v.name }}</td>
      <td class="num">{{ v.cvss }}</td><td class="num">{{ "%.3f" | format(v.epss) }}</td>
      <td>{% if v.in_kev %}<span class="kev">KEV</span> {{ v.kev_cves | join(", ") }}{% else %}-{% endif %}</td>
      <td class="num">{{ v.qod }}</td><td class="num">{{ v.r_v | f3 }}</td></tr>
  {% endfor %}
</table>
{% else %}
<p class="muted">{{ _("路径资产上没有达到 QoD 阈值的漏洞。") }}</p>
{% endif %}

{% if a.needs_review %}
<h2>{{ _("需人工核实") }}</h2>
<div class="banner review">{{ _("以下漏洞命中 CISA KEV，但 QoD < {q}（仅版本比对），未参与风险计算，需人工核实是否真实存在。").format(q=meta.params.min_qod) }}</div>
<table>
  <tr><th>{{ _("资产") }}</th><th>{{ _("端口") }}</th><th>{{ _("漏洞") }}</th><th>KEV CVE</th><th>EPSS</th><th>QoD</th></tr>
  {% for v in a.needs_review %}
  <tr><td>{{ v.asset }}</td><td>{{ v.port }}</td><td>{{ v.name }}</td><td class="kev">{{ v.kev_cves | join(", ") }}</td>
      <td class="num">{{ "%.3f" | format(v.epss) }}</td><td class="num">{{ v.qod }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>{{ _("建议动作") }}</h2>
<ol>
{% for step in actions.steps %}
  <li>{{ step }}</li>
{% endfor %}
</ol>
{% if actions.fixes %}
<p>{{ _("OpenVAS 修复建议：") }}</p>
<ul>
  {% for v in actions.fixes %}
  <li><b>{{ v.name }}</b>{{ _("（{asset} {port}）：").format(asset=v.asset, port=v.port) }}{{ v.solution }}</li>
  {% endfor %}
</ul>
{% endif %}
{% endblock %}
